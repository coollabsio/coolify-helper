root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.sh]
binary_next_line = true
switch_case_indent = true
space_redirects = true

[Dockerfile]
indent_style = space

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
indent_size = unset

[*.lock]
indent_style = space
indent_size = 4

[*.json]
indent_size = unset

[src/affected/**_test.go]
# Go is formatted by gofmt; tests embed YAML, JSON and other fixtures in raw strings
indent_style = unset

[*.txtar]
# Fixture files hold the files of test repositories, in their own formats
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset

[src/affected/testdata/php/*.php]
# The PHP reference matchers follow Coolify's code style
indent_style = space
indent_size = 4
